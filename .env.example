# Required only by the IA worker. The API can run without it for local tests.
GROQ_API_KEY=
DIGISAC_API_KEY=
DIGISAC_API_BASE_URL=https://inov.digisac.chat/api/v1
DIGISAC_DIRECTORY_TIMEOUT_SECONDS=15
DIGISAC_DIRECTORY_MAX_RETRIES=3
DIGISAC_DIRECTORY_SYNC_INTERVAL_SECONDS=86400
DIGISAC_DIRECTORY_REFRESH_COOLDOWN_SECONDS=900
DIGISAC_HISTORY_INITIAL_DELAY_SECONDS=2
DIGISAC_HISTORY_REQUEST_TIMEOUT_SECONDS=15
DIGISAC_HISTORY_MAX_ATTEMPTS=3
DIGISAC_HISTORY_RETRY_BASE_SECONDS=2
FINALIZATION_RECONCILE_INTERVAL_SECONDS=5
FINALIZATION_LEASE_SECONDS=300
MEDIA_STATUS_RECHECK_SECONDS=30
QUOTED_MESSAGE_MAX_CHARS=240
IA_CONTEXT_SAFE_INPUT_TOKENS=96000
IA_CONTEXT_CHUNK_TOKENS=12000
IA_CONTEXT_SUMMARY_OUTPUT_TOKENS=1200
# Set this in production to require HMAC-SHA256 signatures on webhook requests.
WEBHOOK_SECRET=
REDIS_URL=redis://localhost:6379
REDIS_DB=0
POSTGRES_DB=cai
POSTGRES_USER=cai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://cai:change-me@localhost:5432/cai
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
# Existing databases still at 0009 must complete the documented backfills first.
ALEMBIC_TARGET_REVISION=head
MAX_MESSAGES_PER_CONVERSATION=50
IA_TIMEOUT_SECONDS=60
MAX_RETRY_ATTEMPTS=3
MODEL_NAME=openai/gpt-oss-120b
AUDIO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TEMPERATURE=0.3
MAX_TOKENS=500
IMAGE_VISION_MODEL=qwen/qwen3.6-27b
IMAGE_VISION_MAX_COMPLETION_TOKENS=5000
IMAGE_MAX_BYTES=4194304
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30
IMAGE_EXTRACTION_TIMEOUT_SECONDS=60
IMAGE_RETRY_BASE_SECONDS=2
IMAGE_RETRY_MAX_DELAY_SECONDS=900
IMAGE_RETRY_PROVIDER_MARGIN_SECONDS=1
IMAGE_DEAD_LETTER_RECOVERY_INTERVAL_SECONDS=60
IA_RETRY_BASE_SECONDS=2
IA_RETRY_MAX_DELAY_SECONDS=900
IA_RETRY_PROVIDER_MARGIN_SECONDS=1
CONTENT_EXTRACTION_WAIT_SECONDS=30
CONTENT_RECOVERY_LEASE_SECONDS=300
CONTENT_RECOVERY_BATCH_SIZE=100
CONTENT_RECONCILE_INTERVAL_SECONDS=5
LOG_LEVEL=INFO
